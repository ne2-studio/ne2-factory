#!/usr/bin/env bash
set -Eeuo pipefail

# The repo being worked on — where .ne2-factory.env and git live. Resolved
# from the working directory, not this script's location, so the factory
# bundle can sit anywhere under the repo (or be moved) without edits.
ROOT_DIR="${NE2_FACTORY_ROOT:-$(git rev-parse --show-toplevel)}"
cd "$ROOT_DIR"

# Shell-only project config (tmux session, scan scopes). Absent is fine —
# every value below has a default.
# shellcheck source=/dev/null
[[ -f "$ROOT_DIR/.ne2-factory.env" ]] && source "$ROOT_DIR/.ne2-factory.env"

LABEL="gap-scout"
TMUX_SESSION="${TMUX_SESSION:-backlog}"
GAP_SCOUT_SCOPES="${GAP_SCOUT_SCOPES:-app api admin}"
ALLOWED_TOOLS="Agent Bash(gh issue list *) Bash(gh issue create *) Bash(gh issue view *) Bash(gh label create *)"

usage() {
  cat <<'EOF'
Usage: bin/gap-scout <command>   (from the root of the repo being worked on)

Commands:
  scan <scope|all> [--yolo]
                        Dispatch the architecture-gap-scout agent over the
                          given scope(s), one `claude` session per scope,
                          each in its own window inside the tmux session
                          (creating it if needed) — same session
                          bin/backlog run uses. Scopes, and what "all"
                          expands to, come from GAP_SCOUT_SCOPES in
                          .ne2-factory.env (default: app api admin). Returns as soon as the
                          session(s) are launched; doesn't wait for them to
                          finish. Each session dedupes against already-filed
                          initiatives and files new ones as GitHub issues
                          (label "gap-scout"). Read-only over the code; only
                          creates GitHub issues (and, once, the "gap-scout"
                          label).
                          If a scan is already running (its window still
                          exists), that scope is skipped instead of starting
                          a second overlapping session. A finished session
                          stays in its window (doesn't auto-close) — attach
                          to inspect what it found even after it's done,
                          e.g. if filing an issue failed partway through.

Without --yolo, a command outside the narrow allow-list (only gh
issue/label) pauses for approval in its tmux window instead of hanging with
no one able to answer — attach with `tmux attach -t backlog` (or forward it
to your phone with Remote Control) to answer it. Expect this fairly often:
the inspection runs a lot of ad-hoc shell pipelines (churn analysis,
grep/sed chains) a narrow allow-list can't realistically cover.

--yolo runs claude with --dangerously-skip-permissions instead: no prompts
at all, so nothing ever needs answering or gets forwarded to your phone —
safe to leave running unattended (e.g. from a systemd timer) while still
landing in tmux for you to check on later. Reasonable specifically for this
agent (unlike work-ticket's --yolo, which also skips the commit/push
approval): architecture-gap-scout never touches git or edits code, so the
only thing being unblocked is shell access to a read-only inspection, not a
write path. Still no technical safety net if something in the repo's
content tried to steer the agent.

Filed issues are not queued for execution by themselves. Review one, and if
you want it done, add the "backlog" label — that hands it to
bin/backlog's existing worker, same as any other ticket. Leaving it
unlabeled (or closing it) means "not now"; it won't be re-filed verbatim on
the next scan.

Requires `gh` and `tmux`. See the factory's docs/backlog/gap-scout.md for how to schedule
this with a systemd timer.
EOF
}

ensure_labels() {
  # "already exists" is fine and expected after the first run; anything else gets printed
  # instead of swallowed, so a real failure (auth, permissions) is visible in the logs.
  local err
  if ! err="$(gh label create "$LABEL" --color "5319E7" \
      --description "Architecture initiative proposed by gap-scout, pending approval" 2>&1 >/dev/null)"; then
    grep -qi "already exists" <<<"$err" || echo "aviso: no se pudo crear la label '$LABEL': $err" >&2
  fi
}

# Launches one scan as its own tmux window inside $TMUX_SESSION, creating the session if it
# doesn't exist yet. Skips it if a window for this scope is already running. remain-on-exit
# is turned on for the window so the transcript stays inspectable even after claude exits.
_dispatch_one() {
  local scope="$1"; shift
  local claude_flags=("$@")
  local window="gap-scout-${scope%/}"
  local prompt
  prompt="$(printf 'Spawn the `architecture-gap-scout` agent with:\n\nScope: %s\n' "$scope")"

  if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    if tmux list-windows -t "$TMUX_SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$window"; then
      echo "aviso: la ventana tmux '$TMUX_SESSION:$window' ya existe (escaneo previo aún corriendo o sin cerrar); lo salto." >&2
      return 0
    fi
    tmux new-window -t "$TMUX_SESSION" -n "$window" claude "$prompt" "${claude_flags[@]}"
  else
    tmux new-session -d -s "$TMUX_SESSION" -n "$window" claude "$prompt" "${claude_flags[@]}"
  fi
  tmux set-window-option -t "$TMUX_SESSION:$window" remain-on-exit on
  echo "Lanzado: $TMUX_SESSION:$window"
}

cmd_scan() {
  local target="${1:-}"
  local yolo=0
  local usage="Uso: bin/gap-scout scan <scope|all> [--yolo]  (scopes: $GAP_SCOUT_SCOPES)"
  case "${2:-}" in
    --yolo) yolo=1 ;;
    "") ;;
    *) echo "$usage" >&2; exit 1 ;;
  esac

  local scopes=()
  if [[ "$target" == "all" ]]; then
    read -r -a scopes <<<"$GAP_SCOUT_SCOPES"
  elif [[ -n "$target" && " $GAP_SCOUT_SCOPES " == *" $target "* ]]; then
    scopes=("$target")
  else
    echo "$usage" >&2; exit 1
  fi

  local claude_flags=()
  if (( yolo )); then
    claude_flags+=(--dangerously-skip-permissions)
  else
    claude_flags+=(--allowed-tools "$ALLOWED_TOOLS")
  fi

  ensure_labels
  local s
  for s in "${scopes[@]}"; do
    _dispatch_one "${s%/}/" "${claude_flags[@]}"
  done
  echo "Adjunta con: tmux attach -t $TMUX_SESSION"
}

case "${1:-}" in
  scan) shift; cmd_scan "$@" ;;
  -h|--help|"") usage ;;
  *) echo "Comando desconocido: $1" >&2; usage; exit 1 ;;
esac
