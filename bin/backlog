#!/usr/bin/env bash
set -Eeuo pipefail

# The repo being worked on — where .backlog/, .ne2-factory.env and git live.
# Resolved from the working directory, not this script's location, so the
# factory bundle can sit anywhere under the repo (or be moved) without edits.
ROOT_DIR="${NE2_FACTORY_ROOT:-$(git rev-parse --show-toplevel)}"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
cd "$ROOT_DIR"

# Shell-only project config (tmux session, gap-scout scopes). Absent is fine —
# every value below has a default.
# shellcheck source=/dev/null
[[ -f "$ROOT_DIR/.ne2-factory.env" ]] && source "$ROOT_DIR/.ne2-factory.env"

BACKLOG_DIR="$ROOT_DIR/.backlog"
SIGNAL_FILE="$BACKLOG_DIR/.signal"
TMUX_SESSION="${TMUX_SESSION:-backlog}"
QUEUE_LABEL="backlog"
REFINED_LABEL="refined"
FAILED_LABEL="backlog:failed"

usage() {
  cat <<'EOF'
Usage: bin/backlog <command>   (from the root of the repo being worked on)

Commands:
  add [file]        Create a GitHub issue and add it to the queue (label
                      "backlog"). Reads from <file> if given, else from
                      stdin. First line becomes the issue title. Not picked
                      up by `run` until it also carries the "refined" label
                      — see the `refine-backlog` skill.
  list               List queued (refined/unrefined split)/done/failed
                      tickets (GitHub issues).
  requeue <number>   Move a failed/blocked issue back into the queue.
  run --yolo         Start the orchestrator (tmux session running the worker)
                      and attach to it. The worker polls the queue every 30s
                      (BACKLOG_POLL_INTERVAL to override) and keeps running,
                      picking up tickets labeled both "backlog" and "refined"
                      — no need to restart it per ticket. Safe to detach
                      (Ctrl-b d) and reattach later with:
                        tmux attach -t backlog
                      --yolo is mandatory: every ticket runs headless via
                      `claude --print --dangerously-skip-permissions`, so
                      there is never anyone to answer a prompt — only run
                      this when you're comfortable leaving it fully
                      unattended.
  stop               Kill the orchestrator tmux session.

The worker stops polling (leaving the tmux session up) if a ticket ends
without a clear done/blocked signal — that needs a human look before
resuming; requeue/fix the issue and `bin/backlog stop && run` again.

Tickets live as GitHub issues on this repo, not on the local filesystem:
  queued, not yet refined   open issue,   label "backlog", no "refined"
  queued, ready             open issue,   labels "backlog" + "refined"
  done                      closed issue, label "backlog"
  failed                    open issue,   label "backlog:failed"

Run the `refine-backlog` skill interactively (in a normal `claude` session,
not this worker) to turn queued tickets into refined ones before `run` picks
them up — that's also the only place in the pipeline where clarifying
questions get asked; this worker never asks anything.

Each refined ticket runs in its own fresh, non-interactive `claude --print`
session (the work-ticket skill) with permission prompts skipped entirely, so
git commit/push happen straight to the project's default branch with no
approval step. Requires `gh` authenticated against this repo.
EOF
}

ensure_dirs() {
  mkdir -p "$BACKLOG_DIR"
}

ensure_labels() {
  gh label create "$QUEUE_LABEL" --color "0E8A16" \
    --description "Backlog ticket queued for bin/backlog" >/dev/null 2>&1 || true
  gh label create "$REFINED_LABEL" --color "0E8A16" \
    --description "Ticket refinado, listo para bin/backlog" >/dev/null 2>&1 || true
  gh label create "$FAILED_LABEL" --color "B60205" \
    --description "Backlog ticket blocked, needs review before requeuing" >/dev/null 2>&1 || true
}

cmd_add() {
  ensure_labels
  local content
  if [[ "${1:-}" ]]; then
    content="$(cat "$1")"
  else
    content="$(cat)"
  fi
  [[ -n "$content" ]] || { echo "Ticket vacío, no se ha añadido." >&2; exit 1; }

  local title body
  title="$(head -n1 <<<"$content" | sed -E 's/^#+\s*//')"
  [[ -n "$title" ]] || { echo "El ticket no tiene título (primera línea vacía)." >&2; exit 1; }
  body="$(tail -n +2 <<<"$content" | sed -E '/./,$!d')"

  local url
  url="$(gh issue create --label "$QUEUE_LABEL" --title "$title" --body "${body:-$title}")"
  echo "Añadido: $url"
}

cmd_list() {
  echo "En cola, sin refinar:"
  gh issue list --label "$QUEUE_LABEL" --state open --json number,title,labels \
    --jq '.[] | select((.labels|map(.name)|index("'"$REFINED_LABEL"'"))|not) | "  #\(.number)  \(.title)"'
  echo "En cola, lista para implementar:"
  gh issue list --label "$QUEUE_LABEL" --label "$REFINED_LABEL" --state open \
    --json number,title --jq '.[] | "  #\(.number)  \(.title)"'
  echo "Hechos:"
  gh issue list --label "$QUEUE_LABEL" --state closed \
    --json number,title --jq '.[] | "  #\(.number)  \(.title)"'
  echo "Fallidos/bloqueados:"
  gh issue list --label "$FAILED_LABEL" --state open \
    --json number,title --jq '.[] | "  #\(.number)  \(.title)"'
}

cmd_requeue() {
  local n="${1:-}"
  [[ "$n" =~ ^[0-9]+$ ]] || { echo "Uso: bin/backlog requeue <número-de-issue>" >&2; exit 1; }
  gh issue edit "$n" --remove-label "$FAILED_LABEL" --add-label "$QUEUE_LABEL" >/dev/null
  echo "Reencolado: #$n"
}

POLL_INTERVAL="${BACKLOG_POLL_INTERVAL:-30}"

# Runs inside the worker tmux pane. Polls the queue forever, processing
# issues as they appear.
_worker() {
  ensure_dirs
  local claude_flags=(--print --dangerously-skip-permissions)

  echo "Escuchando issues con label '$QUEUE_LABEL' (cada ${POLL_INTERVAL}s). Ctrl-C o 'bin/backlog stop' para parar."
  while true; do
    if ! _process_queue "${claude_flags[@]}"; then
      echo "Worker detenido (revisión manual necesaria antes de reanudar)."
      return 1
    fi
    sleep "$POLL_INTERVAL"
  done
}

# Processes every currently queued issue once. Returns 1 if it hit a
# condition that needs human review before polling should resume.
_process_queue() {
  local claude_flags=("$@")
  local issues
  issues="$(gh issue list --label "$QUEUE_LABEL" --label "$REFINED_LABEL" --state open \
    --json number --jq '.[].number' | sort -n)"
  if [[ -z "$issues" ]]; then
    return 0
  fi

  local n title body url seen=0 total=0
  total="$(wc -l <<<"$issues")"
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    # Otro proceso pudo haber reencolado/movido el issue entre tanto; re-verifica.
    if ! gh issue view "$n" --json state,labels \
        --jq 'select(.state=="OPEN" and (.labels|map(.name)|any(.=="'"$QUEUE_LABEL"'")) and (.labels|map(.name)|any(.=="'"$REFINED_LABEL"'")))' \
        | grep -q .; then
      continue
    fi

    git pull --ff-only

    rm -f "$SIGNAL_FILE"
    local issue_json comments
    issue_json="$(gh issue view "$n" --json title,body,url,comments)"
    title="$(jq -r '.title' <<<"$issue_json")"
    body="$(jq -r '.body // ""' <<<"$issue_json")"
    url="$(jq -r '.url' <<<"$issue_json")"
    # Comment block shape matches the read-github-ticket skill's convention —
    # keep both in sync if this ever changes.
    comments="$(jq -r '.comments[]? | "-- comment by \(.author.login) (\(.createdAt)) --\n\(.body)"' <<<"$issue_json")"

    seen=$(( seen + 1 ))
    echo
    echo "=================================================="
    echo "Ticket: #$n $title"
    echo "=================================================="
    local prompt
    prompt="$(printf '/work-ticket\n\nGitHub issue: #%s (%s)\n\n%s\n\n%s\n\n%s' "$n" "$url" "$title" "$body" "$comments")"
    claude "${claude_flags[@]}" "$prompt" || true

    if [[ -f "$SIGNAL_FILE" ]]; then
      local status reason
      status="$(sed -n 's/^status=//p' "$SIGNAL_FILE" | head -n1)"
      reason="$(sed -n 's/^reason=//p' "$SIGNAL_FILE" | head -n1)"
      case "$status" in
        done)
          # El skill ya ha dejado el resumen como comentario en el issue.
          gh issue close "$n" >/dev/null
          echo "-> hecho: #$n"
          ;;
        blocked)
          # El skill ya ha dejado el motivo como comentario en el issue.
          gh issue edit "$n" --remove-label "$QUEUE_LABEL" --add-label "$FAILED_LABEL" >/dev/null
          echo "-> bloqueado: #$n${reason:+ ($reason)}. Revisa y usa 'requeue $n' si procede."
          ;;
        *)
          echo "-> señal desconocida ('$status'), dejo #$n en cola para revisión manual."
          return 1
          ;;
      esac
      rm -f "$SIGNAL_FILE"
    else
      echo "-> la sesión terminó sin señal (salida manual/crash). Dejo #$n en cola y paro."
      return 1
    fi
  done <<<"$issues"
  echo
  echo "Pasada de cola completada. Vistos: $seen/$total tickets."
  return 0
}

cmd_run() {
  [[ "${1:-}" == "--yolo" ]] || { echo "Uso: bin/backlog run --yolo" >&2; usage; exit 1; }

  ensure_dirs
  ensure_labels
  if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    echo "Ya hay una sesión '$TMUX_SESSION' corriendo. Conectando..."
    exec tmux attach -t "$TMUX_SESSION"
  fi
  tmux new-session -d -s "$TMUX_SESSION" -n main "$SELF" __worker
  echo "Orquestador arrancado en tmux '$TMUX_SESSION': claude corre con --print --dangerously-skip-permissions, sin prompts."
  exec tmux attach -t "$TMUX_SESSION"
}

cmd_stop() {
  tmux kill-session -t "$TMUX_SESSION" 2>/dev/null && echo "Sesión '$TMUX_SESSION' detenida." || echo "No había sesión corriendo."
}

case "${1:-}" in
  add) shift; cmd_add "$@" ;;
  list) cmd_list ;;
  requeue) shift; cmd_requeue "$@" ;;
  run) shift; cmd_run "$@" ;;
  stop) cmd_stop ;;
  __worker) shift; _worker "$@" ;;
  -h|--help|"") usage ;;
  *) echo "Comando desconocido: $1" >&2; usage; exit 1 ;;
esac
